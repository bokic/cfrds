#!/usr/bin/env bash
#
# pre-push hook: reject the push when the version in rust/Cargo.toml does not
# match the most recent git tag (X.Y.Z), mirroring the C build's
# `git describe --tags --abbrev=0` versioning.
#
# Install (per developer/clone):  git config core.hooksPath .githooks

set -euo pipefail

TAG="$(git describe --tags --abbrev=0 2>/dev/null || true)"

if [ -z "$TAG" ]; then
    echo "pre-push: no git tag found; skipping version check" >&2
    exit 0
fi

if ! printf '%s' "$TAG" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    echo "pre-push: git tag '$TAG' is not a valid X.Y.Z version" >&2
    exit 1
fi

CARGO_VERSION="$(sed -n 's/^version = "\([0-9.]*\)"/\1/p' rust/Cargo.toml | head -1)"

if [ -z "$CARGO_VERSION" ]; then
    echo "pre-push: could not read version from rust/Cargo.toml" >&2
    exit 1
fi

if [ "$TAG" != "$CARGO_VERSION" ]; then
    echo "pre-push: version mismatch: git tag is '$TAG' but rust/Cargo.toml has '$CARGO_VERSION'" >&2
    echo "pre-push: run ./rust/build.sh to sync, or fix rust/Cargo.toml, and try again" >&2
    exit 1
fi

echo "pre-push: version check OK ($TAG)" >&2
exit 0
